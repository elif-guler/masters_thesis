orters).;experiment=EXISTENCE: identified in proteomics study;gbkey=CDS;gene=ugpC;inference=protein motif:PROSITE:PS00211;locus_tag=Rv2832c;product=Probable Sn-glycerol-3-phosphate transport ATP-binding protein ABC transporter UgpC;protein_id=CCP45633.1;transl_table=11
