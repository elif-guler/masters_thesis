library(ggplot2)

theme_thesis <- function() {

  theme_bw(base_size = 12) +

    theme(

      # -------------------------
      # Panel grid
      # -------------------------

      panel.grid.major = element_line(
        colour = "grey85",
        linewidth = 0.35
      ),

      panel.grid.minor = element_blank(),

      panel.border = element_rect(
        colour = "black",
        fill = NA,
        linewidth = 0.6
      ),

      # -------------------------
      # Facet labels
      # -------------------------

      strip.background = element_rect(
        fill = "grey95",
        colour = "black",
        linewidth = 0.5
      ),

      strip.text = element_text(
        size = 12,
        face = "bold"
      ),

      # -------------------------
      # Axis
      # -------------------------

      axis.title = element_text(
        size = 13,
        face = "bold"
      ),

      axis.text = element_text(
        size = 11,
        colour = "black"
      ),

      axis.ticks = element_line(
        colour = "black",
        linewidth = 0.5
      ),

      axis.ticks.length = unit(
        3,
        "pt"
      ),

      # -------------------------
      # Plot title
      # -------------------------

      plot.title = element_text(
        size = 15,
        face = "bold",
        hjust = 0.5
      ),

      # -------------------------
      # Legend
      # -------------------------

      legend.position = "top",

      legend.title = element_text(
        size = 12
      ),

      legend.text = element_text(
        size = 11
      ),

      # -------------------------
      # Margins
      # -------------------------

      plot.margin = margin(
        10,
        10,
        10,
        10
      )
    )
}


save_thesis_plot <- function(
    plot,
    filename,
    width,
    height
) {

  ggsave(
    filename = filename,
    plot = plot,
    width = width,
    height = height,
    units = "in",
    device = cairo_pdf,
    bg = "white"
  )
}
