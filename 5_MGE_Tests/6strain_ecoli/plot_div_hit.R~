#!/usr/bin/env Rscript

# plot_div_hit.R
#
# Usage:
#
#   Rscript plot_div_hit.R e5
#   Rscript plot_div_hit.R e10
#
# Produces:
#
#   divergence_vs_fraction_hit_grid_e5.png
#   divergence_vs_fraction_hit_grid_e10.png
#
# Layout:
#
#   2 rows x 6 columns
#
#   Rows:
#       seqwin
#       fur
#
#   Columns:
#       Clade A
#       Clade B1
#       Clade B2
#       Clade D
#       Clade E
#       Clade F
#
# x-axis = fraction of non-target genomes hit
# y-axis = divergence


library(ggplot2)


# ==================================================
# Read command-line argument
# ==================================================

args <- commandArgs(trailingOnly = TRUE)

if (length(args) == 0) {
    evalue_name <- "e5"
} else {
    evalue_name <- args[1]
}


# ==================================================
# Select input files
# ==================================================

if (evalue_name == "e5") {

    tools <- c(
        seqwin = "cons_div_seqwin_e5.csv",
        fur    = "cons_div_fur_e5.csv"
    )

    output_file <- "divergence_vs_fraction_hit_grid_e5.png"

    plot_title <- "Divergence vs Fraction of Non-target Hits (BLAST E-value 1e-5)"

} else if (evalue_name == "e10") {

    tools <- c(
        seqwin = "cons_div_seqwin_e10.csv",
        fur    = "cons_div_fur_e10.csv"
    )

    output_file <- "divergence_vs_fraction_hit_grid_e10.png"

    plot_title <- "Divergence vs Fraction of Non-target Hits (BLAST E-value 1e-10)"

} else {

    stop(
        "Invalid argument. Use e5 or e10.\n"
    )

}


# ==================================================
# Dataset / clade names
# ==================================================

dataset_names <- c(
    a  = "Clade A",
    b1 = "Clade B1",
    b2 = "Clade B2",
    d  = "Clade D",
    e  = "Clade E",
    f  = "Clade F"
)


# ==================================================
# Read all CSV files
# ==================================================

all_data <- list()


for (ds in names(dataset_names)) {

    for (tool in names(tools)) {

        path <- file.path(
            ds,
            tools[[tool]]
        )

        if (!file.exists(path)) {

            message("missing: ", path)

            next
        }


        # Check whether file contains data
        lines <- readLines(path, warn = FALSE)

        if (length(lines) <= 1) {

            message("empty: ", path)

            next
        }


        df <- read.csv(
            path,
            stringsAsFactors = FALSE
        )


        if (nrow(df) == 0) {

            message("empty: ", path)

            next
        }


        # Add metadata
        df$clade <- dataset_names[[ds]]
        df$tool <- tool


        all_data[[length(all_data) + 1]] <- df

    }
}


# ==================================================
# Check that we have data
# ==================================================

if (length(all_data) == 0) {

    stop(
        "No non-empty CSV files were found."
    )

}


# ==================================================
# Combine all datasets
# ==================================================

combined <- do.call(
    rbind,
    all_data
)


# ==================================================
# Set plotting order
# ==================================================

combined$tool <- factor(
    combined$tool,
    levels = c("seqwin", "fur")
)


combined$clade <- factor(
    combined$clade,
    levels = c(
        "Clade A",
        "Clade B1",
        "Clade B2",
        "Clade D",
        "Clade E",
        "Clade F"
    )
)


# ==================================================
# Plot
# ==================================================

p <- ggplot(
    combined,
    aes(
        x = fraction_nontarget_hit,
        y = divergence
    )
) +

    geom_point(
        alpha = 0.5,
        size = 1,
        color = "darkred"
    ) +

    facet_grid(
        tool ~ clade
    ) +

    labs(
        x = "Fraction of Non-target Genomes Hit",
        y = "Divergence",
        title = plot_title
    ) +

    theme_bw(
        base_size = 10
    ) +

    theme(
        plot.title = element_text(
            hjust = 0.5,
            face = "bold"
        )
    )


# ==================================================
# Save plot
# ==================================================

ggsave(
    filename = output_file,
    plot = p,
    width = 16,
    height = 6,
    dpi = 300
)


message(
    "wrote ",
    output_file
)
